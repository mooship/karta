{
  "name": "@karta/web",
  "version": "1.0.0",
  "description": "Karta web SPA map viewer",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "preview": "wrangler dev --config ../../wrangler.jsonc",
    "preview:e2e": "wrangler dev --config ../../wrangler.e2e.jsonc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:all": "playwright test",
    "test:e2e:local": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps chromium",
    "generate:theme": "tsx scripts/generateM3Theme.ts",
    "generate:og-image": "tsx scripts/generateOgImage.ts",
    "messages:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations --no-emit-git-ignore --no-emit-prettier-ignore --no-emit-readme --is-server \"import.meta.env?.SSR ?? typeof window === 'undefined'\""
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@inlang/paraglide-js": "^2.24.1",
    "@inlang/plugin-message-format": "^4.4.3",
    "@material/material-color-utilities": "^0.4.0",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "fontaine": "^0.8.0",
    "happy-dom": "^20.11.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@karta/app": "file:../app",
    "@karta/core": "file:../core",
    "@karta/map": "file:../map",
    "@karta/react": "file:../react",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.3.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  }
}
