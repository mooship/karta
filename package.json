{
  "name": "karta",
  "version": "1.0.0",
  "description": "Reusable SDK for public-interest geospatial layer platforms",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "biome check . && pnpm run depcruise",
    "depcruise": "depcruise packages/*/src --config .dependency-cruiser.cjs",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @karta/web run test:e2e",
    "typecheck": "pnpm --filter @karta/core run typecheck && pnpm --filter @karta/app run typecheck && pnpm --filter @karta/theme run typecheck && pnpm --filter @karta/map run typecheck && pnpm --filter @karta/react run typecheck && pnpm --filter @karta/web run build && pnpm --dir data-pipeline run typecheck",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@inlang/plugin-message-format": "^4.4.4",
    "@swc/core": "^1.16.2",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.4.0",
    "lefthook": "^2.1.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  },
  "pnpm": {
    "overrides": {
      "maplibre-gl": "5.24.0"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "lefthook",
      "workerd"
    ]
  }
}
