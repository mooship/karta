{
  "name": "karta",
  "version": "1.0.0",
  "description": "Reusable SDK for public-interest geospatial layer platforms",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check . && bun run depcruise",
    "depcruise": "depcruise packages/*/src --config .dependency-cruiser.cjs",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run --filter @karta/web test:e2e",
    "typecheck": "bun run --filter @karta/core typecheck && bun run --filter @karta/app typecheck && bun run --filter @karta/map typecheck && bun run --filter @karta/react typecheck && bun run --filter @karta/web build && (cd data-pipeline && bun run typecheck)",
    "build": "bun run --filter '*' --if-present build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@swc/core": "^1.16.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.2.0",
    "lefthook": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
