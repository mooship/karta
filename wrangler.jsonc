{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karta",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./packages/web/workers/app.ts",
  "workers_dev": true,
  "cache": {
    // `cross_version_cache` shares cached responses across Worker versions
    // (no cold cache on every deploy), at the cost that a deploy doesn't
    // invalidate an already-cached response on its own. If a future deploy
    // needs to take effect immediately, the fix is a purge from inside the
    // Worker itself (`ctx.cache.purge({ purgeEverything: true })`) — the
    // zone-level Cloudflare purge_cache API does not reach this cache.
    "enabled": true,
    "cross_version_cache": true
  },
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "./packages/web/build/client"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    { "pattern": "karta.timothybrits.co.za", "custom_domain": true },
    { "pattern": "buffer-zones.timothybrits.co.za", "custom_domain": true }
  ]
}
