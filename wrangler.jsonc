{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karta",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./packages/web/workers/app.ts",
  "workers_dev": true,
  "cache": {
    // Temporarily disabled: `cross_version_cache` shares cached responses
    // across Worker versions, so a deploy alone doesn't invalidate a stale
    // cached response, and Cloudflare's zone-level purge_cache API doesn't
    // reach this Worker-internal cache either (it needs an in-Worker
    // `ctx.cache.purge()` call). Disabling stops Cloudflare from consulting
    // the stale cache immediately, per Cloudflare's own docs. Re-enable
    // once confident the current deploy has propagated everywhere.
    "enabled": false,
    "cross_version_cache": true
  },
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "./packages/web/build/client"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    { "pattern": "karta.timothybrits.co.za", "custom_domain": true },
    { "pattern": "buffer-zones.timothybrits.co.za", "custom_domain": true }
  ]
}
